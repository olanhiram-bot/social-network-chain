generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String                    @unique
  password                 String
  avatar                   String?
  cover                    String?
  bio                      String?
  wallet                   Wallet?
  sessions                 Session[]
  posts                    Post[]
  stories                  Story[]
  liveSessions             LiveSession[]
  liveChatMessages         LiveChatMessage[]
  conversationParticipants ConversationParticipant[]
  sentMessages             DirectMessage[]
  pages                    Page[]
  pageFollows              PageFollow[]
  ownedGroups              Group[]
  groupMemberships         GroupMember[]
  marketplaceProducts      MarketplaceProduct[]
  blockedUsers             UserBlock[]               @relation("Blocker")
  blockedBy                UserBlock[]               @relation("Blocked")
  notifications            Notification[]
  sentFriendRequests       FriendRequest[]           @relation("SentFriendRequests")
  receivedFriendRequests   FriendRequest[]           @relation("ReceivedFriendRequests")
  friendships              Friendship[]              @relation("UserFriendships")
  friendOf                 Friendship[]              @relation("FriendOf")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ContentReport {
  id         String   @id @default(cuid())
  reporterId String
  entityType String
  entityId   String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@index([reporterId])
  @@index([entityType, entityId])
  @@index([status])
}

model SocialEvent {
  id          String   @id @default(cuid())
  hostId      String
  pageId      String?
  groupId     String?
  title       String
  description String?
  location    String
  startsAt    DateTime
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hostId])
  @@index([pageId])
  @@index([groupId])
  @@index([startsAt])
}

model SocialEventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
}

model SocialEventInvite {
  id        String   @id @default(cuid())
  eventId   String
  inviterId String
  inviteeId String
  createdAt DateTime @default(now())

  @@unique([eventId, inviteeId])
  @@index([inviteeId])
}

model MarketplaceProduct {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String?
  category    String
  priceCents  Int
  location    String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([category])
  @@index([createdAt])
}

model Page {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  category    String
  description String?
  avatar      String?
  cover       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts     Post[]
  followers PageFollow[]

  @@index([ownerId])
  @@index([name])
  @@index([createdAt])
}

model PageFollow {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
}

model Group {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  privacy     String   @default("PUBLIC")
  cover       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  posts   Post[]

  @@index([ownerId])
  @@index([privacy])
  @@index([createdAt])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  signerAddress  String?
  messageHash    String?
  signature      String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
  @@index([senderId])
}

model Wallet {
  id                  String      @id @default(cuid())
  userId              String      @unique
  address             String      @unique
  encryptedPrivateKey String
  appSigners          AppSigner[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSigner {
  id                  String   @id @default(cuid())
  walletId            String
  address             String   @unique
  encryptedPrivateKey String
  label               String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id            String     @id @default(cuid())
  authorId      String
  pageId        String?
  groupId       String?
  sharedPostId  String?
  audience      String     @default("PUBLIC")
  content       String
  mediaUrl      String?
  mediaType     MediaType?
  metadata      Json       @default("{}")
  signerAddress String?
  messageHash   String?
  signature     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  page   Page?  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  group  Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([pageId])
  @@index([groupId])
  @@index([sharedPostId])
  @@index([audience])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([signerAddress])
}

model Story {
  id            String    @id @default(cuid())
  authorId      String
  caption       String?
  mediaUrl      String
  mediaType     MediaType
  signerAddress String?
  messageHash   String?
  signature     String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
}

model LiveSession {
  id             String            @id @default(cuid())
  hostId         String
  title          String
  status         LiveSessionStatus @default(LIVE)
  startedAt      DateTime          @default(now())
  endedAt        DateTime?
  recordingUrl   String?
  latestFrameUrl String?
  signerAddress  String?
  messageHash    String?
  signature      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  host     User              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  messages LiveChatMessage[]

  @@index([hostId])
  @@index([status, startedAt])
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  liveId    String
  authorId  String
  content   String
  offsetMs  Int
  createdAt DateTime @default(now())

  live   LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([liveId, offsetMs])
  @@index([authorId])
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester User @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  STREAM
}

enum LiveSessionStatus {
  LIVE
  ENDED
}
